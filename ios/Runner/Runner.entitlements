<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Apple ile Giriş Yap" (sign_in_with_apple paketi) için ZORUNLU.
	     Bu entitlement olmadan SignInWithApple.getAppleIDCredential()
	     iOS'ta her zaman hata döner.

	     Xcode tarafındaki karşılığı:
	       Runner target > Signing & Capabilities > + Capability >
	       "Sign in with Apple"
	     Otomatik imzalama açık olduğu için Xcode bunu App ID'ye de ekler. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- NOT: "Günün Kilit Ekranı Kodu" widget'ı (DailyCodeWidget) henüz
	     Xcode projesine bir target olarak EKLENMEDİ (project.pbxproj içinde
	     hiç referansı yok). App Group entitlement'ı, provisioning profile'da
	     karşılığı olmadığında imzalamayı bozduğu için buradan çıkarıldı.
	     Widget target'ı eklendiğinde geri konmalı:

	       <key>com.apple.security.application-groups</key>
	       <array>
	         <string>group.com.kpsshazirlik.kpss_telefon</string>
	       </array>
	-->
</dict>
</plist>
